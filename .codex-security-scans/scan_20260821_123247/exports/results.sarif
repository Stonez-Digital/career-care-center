                },
                "region": {
                  "endLine": 60,
                  "startLine": 44
                }
              }
            }
          ],
          "message": {
            "text": "Newsletter endpoint can reactivate unsubscribed addresses without consent\n\nAny anonymous caller who supplies another person's email can create an active subscription or reverse an inactive state without proving mailbox control.\n\nSeverity: low\n\nCategory: Missing authorization\n\nWeaknesses: CWE-862\n\nRemediation:\nImplement confirmed opt-in with single-use expiring tokens. Store new requests as pending and never reactivate an unsubscribed address without fresh mailbox confirmation; add rate limiting and non-enumerating responses."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:1b1523c22cf2a8a0bc8785de35f15d0fd3d071c14331c379f6235a9653c1013e",
            "primaryLocationLineHash": "df073969114197d6:1"
