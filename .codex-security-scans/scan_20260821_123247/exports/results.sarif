              "physicalLocation": {
                "artifactLocation": {
                  "uri": "supabase/migrations/20260626052737_create_ccc_schema.sql"
                },
                "region": {
                  "endLine": 410,
                  "startLine": 401
                }
              }
            }
          ],
          "message": {
            "text": "Anonymous users can read all partnership inquiries\n\nThe partners table mixes public presentation data with private inquiry names, emails, organizations, interests, and messages, then exposes every row publicly.\n\nSeverity: medium\n\nCategory: Sensitive data exposure\n\nWeaknesses: CWE-862, CWE-200\n\nRemediation:\nSeparate submitted inquiries from approved public partner profiles. Remove public SELECT from the inquiry table and expose only reviewed publication fields from a dedicated table or filtered view."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:91f44048e8f5a37653e1e6631fc91a37d8506e48e5834e105a0a14c3e6dba333",
